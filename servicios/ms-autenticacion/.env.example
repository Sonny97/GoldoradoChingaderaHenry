# ==============================================================================
#  ms-autenticacion - variables de entorno (CONVENCIONES §6)
#  Copiar a .env (que NO se versiona) y ajustar. Los valores de ejemplo sirven
#  para desarrollo local.
# ==============================================================================

# ---------------------------------------------------------------- gRPC
# Puerto y host del servidor gRPC. El BFF lo encuentra en MS_AUTENTICACION_URL.
GRPC_PUERTO=50051
GRPC_HOST=0.0.0.0
# Opcional. Si tiene valor, se exige el metadato x-token-interno en cada
# llamada. Debe ser el MISMO en los 7 procesos (6 servicios + BFF).
GRPC_TOKEN_INTERNO=

# ------------------------------------------------------- SQL Server
# Instalacion local (SQLEXPRESS del monolito): localhost, puerto 1433, login
# goldorado_app con autenticacion mixta (ver README).
# Con docker compose: DB_PORT=1434, DB_USER=sa, DB_PASSWORD=GolDorado_Sa_2026!
DB_SERVER=localhost
DB_PORT=1433
DB_USER=goldorado_app
# Clave del login de SQL Server (solo desarrollo; en produccion, un secreto real).
DB_PASSWORD=GolDorado_App_2026!
# Debe coincidir con la base que crea db/01_esquema.sql.
DB_DATABASE=GolDoradoAuth
# Cifrado TLS hacia SQL Server: false en local, true en Azure SQL.
DB_ENCRYPT=false
# Confiar en el certificado autofirmado de una instalacion local o de docker.
DB_TRUST_SERVER_CERTIFICATE=true

# ------------------------------------------------- token de seguridad
# OBLIGATORIA. Secreto HS256 de los JWT; solo este servicio lo conoce.
# Minimo 32 caracteres aleatorios. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Vigencia de cada token (y de su fila en Sesion): 2h, 30m, o segundos (7200).
JWT_EXPIRES_IN=2h

# ------------------------------------------- recuperacion de contraseña
# Codigo fijo SOLO en desarrollo (NODE_ENV distinto de production): no hay
# proveedor real de correo/SMS y el codigo vuelve en la respuesta (codigoDev).
OTP_CODIGO_DEV=482913
# Minutos de vigencia de una solicitud de recuperacion.
OTP_TTL_MIN=10
# Codigos equivocados permitidos antes de invalidar la solicitud.
OTP_MAX_INTENTOS=5

# ------------------------------------------------------ Google (OIDC)
# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth
# (aplicacion web). Google queda habilitado solo si estan los DOS valores.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------------- Microsoft (Entra ID)
# Registro de aplicacion con plataforma Web. Microsoft queda habilitado solo si
# estan los DOS valores (una app Web es cliente confidencial: exige el secreto).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common = cuentas personales y de organizacion; consumers = solo personales;
# organizations = solo de organizacion; o el GUID de un directorio concreto.
MICROSOFT_TENANT=common

# ----------------------------------------------------------- auditoria
# ms-transacciones (MongoDB) recibe los intentos de sesion y eventos de
# seguridad. Si esta caido el login funciona igual (solo queda un aviso en el
# log). Para no enviar nada: MS_TRANSACCIONES_URL=apagado
MS_TRANSACCIONES_URL=localhost:50054

# ------------------------------------------------------------- general
# development | production (production: codigo OTP aleatorio y sin codigoDev).
NODE_ENV=development
# info | debug (debug muestra cada llamada gRPC con su duracion).
LOG_NIVEL=info
