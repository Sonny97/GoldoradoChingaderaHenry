# =============================================================================
#  ms-apuestas · variables de entorno
#  Copia este archivo a .env (el .env real NO se versiona) y ajusta los valores.
#  Los de abajo son los de DESARROLLO local con docker compose.
# =============================================================================

# ------------------------------------------------------------- servidor gRPC
# Puerto donde escucha ms-apuestas (el BFF y ms-pagos lo buscan en MS_APUESTAS_URL).
GRPC_PUERTO=50053
# 0.0.0.0 = todas las interfaces (necesario en contenedores); 127.0.0.1 = solo esta maquina.
GRPC_HOST=0.0.0.0
# Secreto compartido por los 7 procesos (metadato x-token-interno). Vacio = sin token.
GRPC_TOKEN_INTERNO=

# ---------------------------------------------------------- servicios vecinos
# ms-deportes: se le pregunta el estado del partido antes de aceptar una apuesta.
MS_DEPORTES_URL=localhost:50052
# ms-transacciones: recibe los movimientos de las apuestas por la bandeja de salida.
MS_TRANSACCIONES_URL=localhost:50054

# ----------------------------------------------------------------- PostgreSQL
# Servidor. Azure: <servidor>.postgres.database.azure.com
PG_HOST=localhost
# 5433 = el PostgreSQL de docker compose; 5432 = un PostgreSQL instalado (y Azure).
PG_PORT=5433
# Usuario de la aplicacion (docker compose lo crea con este nombre).
PG_USER=goldorado_app
# Clave del usuario (esta es la de DESARROLLO de docker-compose.yml; obligatoria).
PG_PASSWORD=GolDorado_App_2026!
# Base del servicio (npm run db:setup la crea si el usuario puede).
PG_DATABASE=goldorado_apuestas
# TLS hacia la base. Azure Database for PostgreSQL lo exige: true. Local: false.
PG_SSL=false
# true = validar el certificado del servidor contra las CA del sistema (recomendado en Azure).
PG_SSL_VERIFICAR=false
# Conexiones maximas del pool (UNO por proceso). Azure B1ms admite ~50 en total.
PG_POOL_MAX=10

# ------------------------------------------------ bandeja de salida (outbox)
# Cada cuanto el relevo envia a ms-transacciones los eventos pendientes (ms).
OUTBOX_INTERVALO_MS=3000

# ---------------------------------------------------------------------- comunes
# info | debug
LOG_NIVEL=info
# development | production
NODE_ENV=development
