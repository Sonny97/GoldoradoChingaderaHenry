# =============================================================================
#  ms-deportes · variables de entorno
#
#  Copia este archivo a .env (el .env real NO se versiona). Los valores de
#  ejemplo son los de desarrollo local y coinciden con docker-compose.yml
#  (docs/CONVENCIONES.md, seccion 6).
# =============================================================================

# ---- gRPC -------------------------------------------------------------------
# Puerto donde escucha este servicio (el BFF y ms-apuestas lo llaman aqui).
GRPC_PUERTO=50052
# Interfaz de red: 0.0.0.0 = todas; 127.0.0.1 = solo esta maquina.
GRPC_HOST=0.0.0.0
# Secreto compartido por los 7 procesos (metadato x-token-interno).
# Vacio = no se exige. Si se pone, debe ser el MISMO en todos.
GRPC_TOKEN_INTERNO=

# ---- Registro -----------------------------------------------------------------
# info | debug (debug registra la duracion de cada llamada gRPC).
LOG_NIVEL=info
# development | production
NODE_ENV=development

# ---- MySQL ----------------------------------------------------------------------
# Servidor MySQL 8.0.16+ (instalacion local o el contenedor de docker compose:
# los dos quedan en localhost:3306).
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Usuario de la aplicacion, nunca root. El README explica como crearlo.
MYSQL_USER=goldorado_app
# Clave SOLO de desarrollo (la misma de docker-compose.yml). En la nube va otra.
MYSQL_PASSWORD=GolDorado_App_2026!
# Base de este servicio: ningun otro servicio la lee ni la escribe.
MYSQL_DATABASE=goldorado_deportes
# true para MySQL administrado en la nube (Azure Database for MySQL, RDS...),
# que exige TLS. En local: false.
MYSQL_SSL=false
