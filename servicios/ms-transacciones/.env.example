# =============================================================================
#  ms-transacciones - variables de entorno (copiar a .env; el .env no se versiona)
#  Valores por defecto = desarrollo local (CONVENCIONES §6 y docker-compose.yml).
# =============================================================================

# Puerto gRPC de este servicio (los demas lo buscan en MS_TRANSACCIONES_URL=localhost:50054).
GRPC_PUERTO=50054

# Interfaz donde escucha: 0.0.0.0 = todas; 127.0.0.1 = solo esta maquina.
GRPC_HOST=0.0.0.0

# Secreto compartido entre los 7 procesos (metadato x-token-interno).
# Vacio = sin token (solo desarrollo). Si se usa, el MISMO valor en todos.
GRPC_TOKEN_INTERNO=

# Cadena de conexion a MongoDB.
#   Local o docker compose (servicio "mongo", sin usuario): mongodb://localhost:27017
#   Atlas M0: mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=goldorado
MONGO_URI=mongodb://localhost:27017

# Base de datos del servicio (nadie mas la lee ni la escribe).
MONGO_DB=goldorado_transacciones

# Dias que se conservan los logs de sesion: lo hace cumplir el indice TTL
# IX_LogsSesion_Fecha_TTL. Si se cambia, el servicio ajusta el TTL al arrancar.
LOGS_SESION_DIAS=180

# info | debug (debug muestra cada llamada gRPC con su duracion y los reintentos a Mongo).
LOG_NIVEL=info

# development | production | test
NODE_ENV=development
