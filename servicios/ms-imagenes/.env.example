# =============================================================================
#  ms-imagenes · variables de entorno (copiar a .env; el .env NO se versiona)
#  Guia de Google Drive: docs/GOOGLE-MICROSOFT-DRIVE.md seccion 4
# =============================================================================

# ---------------------------------------------------------------- servidor gRPC
# Puerto gRPC del servicio (el BFF lo busca en MS_IMAGENES_URL=localhost:50056).
GRPC_PUERTO=50056
# Interfaz donde escucha: 0.0.0.0 = todas; 127.0.0.1 = solo esta maquina.
GRPC_HOST=0.0.0.0
# Token compartido entre los 7 procesos (metadato x-token-interno). Vacio = sin token.
GRPC_TOKEN_INTERNO=
# info | debug (debug muestra cada llamada gRPC con su duracion).
LOG_NIVEL=info

# ---------------------------------------------------------------------- almacen
# local = disco (por defecto, para desarrollar sin Google) | drive = Google Drive.
IMAGENES_ALMACEN=local
# Carpeta del modo local, relativa a servicios/ms-imagenes (esta en .gitignore).
IMAGENES_DIR_LOCAL=./storage
# Tamano maximo de una imagen en bytes (5 MB: tope de la subida multipart de Drive).
IMAGENES_MAX_BYTES=5242880
# Memoria para la cache LRU de bytes descargados de Drive (20 MB).
IMAGENES_CACHE_BYTES=20971520

# ----------------------------------------------------------------- Google Drive
# oauth = cuenta @gmail.com con refresh token (opcion A)
# cuenta_servicio = Google Workspace con unidad compartida (opcion B)
DRIVE_AUTENTICACION=oauth

# --- Opcion A: OAuth (cliente "Aplicacion web" con la redireccion
#     http://localhost:53682/oauth2callback y scope drive.file; app PUBLICADA,
#     en "Testing" el refresh token vence a los 7 dias)
# ID de cliente OAuth de Google Cloud Console.
DRIVE_OAUTH_CLIENT_ID=
# Secreto del cliente OAuth.
DRIVE_OAUTH_CLIENT_SECRET=
# Lo imprime "node db/obtener-refresh-token.js" (una sola vez).
DRIVE_OAUTH_REFRESH_TOKEN=

# --- Opcion B: cuenta de servicio (la cuenta debe ser "Administrador de
#     contenido" de la unidad compartida; sin unidad compartida NO tiene cuota)
# Ruta a la llave JSON, relativa a servicios/ms-imagenes (credenciales/ esta en .gitignore).
GOOGLE_DRIVE_CREDENCIALES=./credenciales/drive.json
# Id de la unidad compartida (empieza por 0A...). Obligatoria con cuenta_servicio.
DRIVE_UNIDAD_COMPARTIDA_ID=

# --- Comun a las dos opciones
# Id de la carpeta "GolDorado - Imagenes" (lo imprime npm run db:setup).
# Vacio = se busca por appProperties y, si no existe, se crea por la API.
DRIVE_CARPETA_RAIZ_ID=
# Cada cuanto se reconstruye el indice en memoria desde Drive (ms; 5 minutos).
DRIVE_INDICE_REFRESCO_MS=300000
