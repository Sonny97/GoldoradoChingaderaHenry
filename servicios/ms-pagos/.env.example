# =============================================================================
#  ms-pagos  ·  Firebase (Cloud Firestore) + Wompi  ·  gRPC :50055
#  Copia este archivo como .env (el .env real NUNCA se versiona).
#  Sin cambiar nada corre SIN nube: PAGOS_ALMACEN=memoria + WOMPI_MODO=simulado.
# =============================================================================

# ------------------------------------------------------------------ servidor gRPC
# Puerto gRPC de este servicio.
GRPC_PUERTO=50055
# Interfaz donde escucha (0.0.0.0 = todas; 127.0.0.1 = solo esta maquina).
GRPC_HOST=0.0.0.0
# Secreto compartido entre los 7 procesos (metadato x-token-interno). Vacio = sin token.
GRPC_TOKEN_INTERNO=

# -------------------------------------------------------------- servicios vecinos
# ms-apuestas: AcreditarDeposito (suma el saldo, idempotente por referencia).
MS_APUESTAS_URL=localhost:50053
# ms-transacciones: libro del deposito en MongoDB y eventos de seguridad.
MS_TRANSACCIONES_URL=localhost:50054

# ------------------------------------------------------------------ almacenamiento
# firestore = Cloud Firestore (el motor del tablero) | memoria = Maps, se pierde al reiniciar.
PAGOS_ALMACEN=memoria
# Id del proyecto de Firebase (si se omite se toma del JSON de la cuenta de servicio).
FIREBASE_PROJECT_ID=
# Ruta al JSON de la cuenta de servicio (Consola de Firebase -> Configuracion del
# proyecto -> Cuentas de servicio -> Generar nueva clave privada). Relativa a esta carpeta.
# Ejemplo: credenciales/firebase.json  (la carpeta credenciales/ esta en .gitignore)
FIREBASE_CREDENCIALES=
# Alternativa estandar de Google a FIREBASE_CREDENCIALES (ruta al mismo tipo de JSON).
GOOGLE_APPLICATION_CREDENTIALS=
# Emulador local de Firestore (firebase emulators:start). Ejemplo: 127.0.0.1:8080
FIRESTORE_EMULATOR_HOST=

# --------------------------------------------------------------------------- Wompi
# sandbox (llaves _test_, no mueve dinero) | produccion (real) | simulado (sin llaves ni red).
WOMPI_MODO=simulado
# Llave publica pub_test_... / pub_prod_... (comercios.wompi.co -> Desarrolladores). Puede ir al navegador.
WOMPI_LLAVE_PUBLICA=
# Llave privada prv_test_... / prv_prod_...: crea y consulta transacciones. SECRETO.
WOMPI_LLAVE_PRIVADA=
# Secreto de eventos test_events_... / prod_events_...: verifica el checksum de los webhooks. SECRETO.
WOMPI_SECRETO_EVENTOS=
# Secreto de integridad test_integrity_... / prod_integrity_...: firma referencia+monto. SECRETO.
WOMPI_SECRETO_INTEGRIDAD=
# Plazo de cada llamada HTTP a Wompi, en milisegundos.
WOMPI_PLAZO_MS=15000

# -------------------------------------------------------------------------- montos
# Recarga minima en pesos (Wompi exige al menos 1500; el servicio nunca baja de ahi).
PAGOS_MONTO_MINIMO=5000
# Recarga maxima en pesos.
PAGOS_MONTO_MAXIMO=3000000

# -------------------------------------------------------------------- conciliacion
# Cada cuanto se revisan pagos PENDIENTE viejos, acreditaciones y libro pendientes (ms). 0 = apagada.
CONCILIACION_INTERVALO_MS=60000

# ---------------------------------------------------------------------------- logs
# info | debug
LOG_NIVEL=info
