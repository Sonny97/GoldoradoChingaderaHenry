# =============================================================================
#  BFF de GolDorado (Express, API REST para el frontend)
#  Copia este archivo a .env. Con los valores por defecto funciona en local con
#  los seis microservicios corriendo en localhost:50051..50056.
# =============================================================================

# Entorno: development | production. En production los limites de intentos son
# estrictos (10 / 15 min), la cookie de OAuth exige HTTPS y COOKIE_SECRETO es obligatoria.
NODE_ENV=development

# Puerto HTTP donde escucha el BFF (Vite le hace proxy de /api en desarrollo).
PORT=3000

# Origen(es) del frontend permitidos por CORS, separados por coma. '*' = cualquiera.
CORS_ORIGIN=http://localhost:3003

# URL del frontend: a donde vuelve el usuario despues de Google/Microsoft
# (/auth/callback) y despues de pagar en Wompi (/pagos/resultado).
WEB_URL=http://localhost:3003

# Base publica donde el navegador ve /api. Con ella se arma el redirect_uri de
# OAuth: <URL_PUBLICA_API>/api/auth/oauth/google/callback (registralo igual en
# la consola de Google y de Microsoft).
URL_PUBLICA_API=http://localhost:3003

# Secreto para firmar la cookie del flujo OAuth (state, nonce, code_verifier).
# Vacio en desarrollo = uno aleatorio por arranque. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRETO=

# En quien confiar para X-Forwarded-For (IP real del cliente):
# loopback (Vite/nginx en la misma maquina) | true | false | numero de saltos | lista de IPs.
TRUST_PROXY=loopback

# Direcciones gRPC (host:puerto) de los seis microservicios.
MS_AUTENTICACION_URL=localhost:50051
MS_DEPORTES_URL=localhost:50052
MS_APUESTAS_URL=localhost:50053
MS_TRANSACCIONES_URL=localhost:50054
MS_PAGOS_URL=localhost:50055
MS_IMAGENES_URL=localhost:50056

# Secreto compartido entre los 7 procesos (metadato x-token-interno). Vacio = sin token.
# Si se define, debe ser EL MISMO en el BFF y en los seis servicios.
GRPC_TOKEN_INTERNO=

# Nivel de log: info | debug (debug muestra cada error gRPC traducido a HTTP).
LOG_NIVEL=info
